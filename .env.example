# Copy to .env.local for local development. Every variable is optional:
# with none set, Billions runs as a browser-only prototype with template summaries.

# --- Accounts and storage (Postgres 13+). Setting this switches the app to sign-in mode. ---
# Connect as a role WITHOUT superuser or BYPASSRLS: the app refuses tenant data otherwise (see README).
DATABASE_URL=
# Owner role used only by `npm run db:migrate`. Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=
# Connections per server instance (default 5). Use the provider's pooled URL on serverless.
DATABASE_POOL_MAX=

# --- AI (Claude) ---
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Model id (default claude-opus-5-5).
BILLIONS_MODEL=
# Model calls per business per UTC day, counting report summaries and chat (default 100).
BILLIONS_AI_DAILY_LIMIT=
# Model calls per UTC day across every business: the hard ceiling on spend (default 2000).
BILLIONS_AI_GLOBAL_DAILY_LIMIT=
# New workspaces per client IP per hour (default 5).
BILLIONS_SIGNUPS_PER_IP_PER_HOUR=
# "off" disables the model even when a key is set.
BILLIONS_AI=
# "on" lets signed-out visitors use the model when DATABASE_URL is unset. Each server
# instance allows 20 calls an hour per IP, which is no real limit on serverless: demos only.
BILLIONS_ANONYMOUS_AI=
