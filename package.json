{
  "name": "naxium-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "next build && playwright test",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "eval:spreadsheet": "node --experimental-strip-types eval/spreadsheet.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@react-pdf/renderer": "^4.5.1",
    "@vercel/functions": "^3.10.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "inngest": "^4.2.4",
    "jszip": "^3.10.2",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "^5.0.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
